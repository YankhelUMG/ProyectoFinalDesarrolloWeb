# Rutas y restricciones de acceso del proyecto.
RewriteEngine On
RewriteRule ^(?:\.git|database|config|includes|sql|uploads|docs|tests|api/(?:core|models|helpers|controladores))(?:/|$) - [F,L,NC]
# Conserva el prefijo de URL; no expone rutas de disco de Windows al redirigir.
RewriteCond %{REQUEST_URI} ^(.*)/[^/]+\.php$ [NC]
RewriteRule ^(?:admin|empresa|perfil|registro|roles|seguimiento)\.php$ %1/index.php [R=302,L,NC]
RewriteCond %{REQUEST_URI} ^(.*)/pages/ [NC]
RewriteRule ^pages/(practicas|empresa|perfil|postulaciones|administracion|consultas)/index\.php$ %1/pages/$1.php [R=302,L,NC]
RewriteCond %{REQUEST_URI} ^(.*)/pages/ [NC]
RewriteRule ^pages/empleados/index\.php$ %1/pages/usuarios.php [R=302,L,NC]
RewriteCond %{REQUEST_URI} ^(.*)/pages/ [NC]
RewriteRule ^pages/admin\.php$ %1/pages/administracion.php [R=302,L,NC]
RewriteCond %{REQUEST_URI} ^(.*)/pages/ [NC]
RewriteRule ^pages/roles\.php$ %1/pages/usuarios.php [R=302,L,NC]
RewriteCond %{REQUEST_URI} ^(.*)/pages/ [NC]
RewriteRule ^pages/seguimiento\.php$ %1/pages/postulaciones.php [R=302,L,NC]
RewriteCond %{QUERY_STRING} (?:^|&)tipo=empresa(?:&|$) [NC]
RewriteCond %{REQUEST_URI} ^(.*)/pages/ [NC]
RewriteRule ^pages/registro\.php$ %1/public/registro-empresa.html [R=302,L,NC]
RewriteCond %{REQUEST_URI} ^(.*)/pages/ [NC]
RewriteRule ^pages/registro\.php$ %1/public/registro-estudiante.html [R=302,L,NC]
RewriteCond %{REQUEST_URI} ^(.*)/practicas-disponibles/ [NC]
RewriteRule ^practicas-disponibles/practicas-disponibles\.php$ %1/public/practicas.php [R=302,L,NC]
RewriteRule ^api/(?!index\.php$)(?!auth\.php$)(?!auth/login\.php$)(?!admin/roles(?:/index)?\.php$)(?!acceso-catalogos/POST/auth\.php$)(?!consultas/GET/cv\.php$)(?!administracion/POST/(?:empresas|usuarios)\.php$)(?!practicas/POST/oportunidades\.php$)(?!postulaciones/POST/postulaciones\.php$)(?!perfil/POST/(?:perfil|perfil_empresa)\.php$).*\.php$ - [F,L,NC]
