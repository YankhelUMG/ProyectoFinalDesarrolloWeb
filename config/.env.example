# Plantilla de variables. Guarda la copia real fuera de htdocs, por ejemplo:
# C:/xampp/private/practicas.env
# APP_DATABASE_CONFIG puede señalar una ubicación distinta si hace falta.
DATABASE_HOST=127.0.0.1
DATABASE_NAME=sistema_practicas
DATABASE_USER=practicas_app
DATABASE_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA
PRIVATE_UPLOAD_DIR=C:/xampp/private/cv
APP_TIMEZONE=America/Guatemala
